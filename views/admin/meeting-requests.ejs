<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>

  <div class="admin-wrapper">
    <%- include('../partials/admin-sidebar', { currentUser: currentUser, activeSection: 'meeting-requests' }) %>

    <!-- MAIN CONTENT AREA -->
    <main class="admin-content">
      
      <!-- TOP CONTENT BAR -->
      <div class="content-header">
        <div>
          <h2 class="content-title">Meeting Requests &amp; Leads</h2>
          <p class="text-muted mb-0" style="font-size: 0.88rem;">
            Prospect submissions received from the TraWis hero section (Energy Trading Week Americas 2026).
          </p>
        </div>
        
        <div>
          <span class="badge bg-warning text-dark px-3 py-2 fw-bold" style="border-radius: 999px;">
            <i class="bi bi-envelope-check me-1"></i> Dispatched to sales@bluwis.com
          </span>
        </div>
      </div>
      
      <!-- MINI METRICS ROW -->
      <div class="row g-3 mb-4">
        <div class="col-md-4">
          <div class="metric-card">
            <div class="metric-icon">
              <i class="bi bi-people"></i>
            </div>
            <div>
              <h4 class="metric-number"><%= requests.length %></h4>
              <span class="metric-label">Total Meeting Requests</span>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="metric-card">
            <div class="metric-icon icon-primary">
              <i class="bi bi-building"></i>
            </div>
            <div>
              <h4 class="metric-number">
                <%= new Set(requests.map(r => (r.company || '').trim().toLowerCase())).size %>
              </h4>
              <span class="metric-label">Unique Companies</span>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="metric-card">
            <div class="metric-icon" style="background: rgba(255, 196, 0, 0.12); color: #ffc400;">
              <i class="bi bi-calendar-event"></i>
            </div>
            <div>
              <h4 class="metric-number">ETW Americas</h4>
              <span class="metric-label">Primary Campaign</span>
            </div>
          </div>
        </div>
      </div>
      
      <!-- LEADS TABLE PANEL -->
      <div class="admin-card">
        <% if (requests.length === 0) { %>
          <div class="text-center py-5">
            <i class="bi bi-inbox text-muted mb-3 d-block" style="font-size: 2.5rem;"></i>
            <h5 class="fw-bold">No meeting requests yet</h5>
            <p class="text-muted mb-3 fs-9">Requests submitted through "Book a Meet" will be listed here and synced to sales@bluwis.com.</p>
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th style="width: 22%;">Prospect &amp; Company</th>
                  <th style="width: 18%;">Job Title</th>
                  <th style="width: 22%;">Contact Info</th>
                  <th style="width: 26%;">Preferred Date &amp; Time Slot</th>
                  <th style="width: 12%;">Submitted</th>
                </tr>
              </thead>
              <tbody>
                <% requests.forEach(item => { %>
                  <tr>
                    <td>
                      <div class="fw-bold text-dark"><%= item.name %></div>
                      <div class="text-muted" style="font-size: 0.82rem;">
                        <i class="bi bi-building me-1"></i><%= item.company %>
                      </div>
                    </td>
                    <td>
                      <span class="badge bg-light text-dark border">
                        <%= item.job_title || item.jobTitle %>
                      </span>
                    </td>
                    <td>
                      <div style="font-size: 0.86rem;">
                        <a href="mailto:<%= item.email %>" class="text-decoration-none text-primary">
                          <i class="bi bi-envelope me-1"></i><%= item.email %>
                        </a>
                      </div>
                      <div class="text-muted" style="font-size: 0.82rem; margin-top: 2px;">
                        <a href="tel:<%= item.phone %>" class="text-decoration-none text-muted">
                          <i class="bi bi-telephone me-1"></i><%= item.phone %>
                        </a>
                      </div>
                    </td>
                    <td>
                      <% if (item.preferred_date || item.preferred_time_slot || item.notes) { %>
                        <div class="fw-semibold text-dark" style="font-size: 0.85rem; line-height: 1.4;">
                          <i class="bi bi-calendar2-check text-warning me-1"></i>
                          <%= item.preferred_date && item.preferred_time_slot ? (item.preferred_date + ' • ' + item.preferred_time_slot) : (item.notes || item.preferred_date || item.preferred_time_slot) %>
                        </div>
                      <% } else { %>
                        <span class="text-muted fst-italic" style="font-size: 0.8rem;">Not specified</span>
                      <% } %>
                    </td>
                    <td class="text-muted" style="font-size: 0.82rem;">
                      <%= item.created_at ? new Date(item.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Recently' %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
